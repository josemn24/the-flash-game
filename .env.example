# Copy to .env.local for the local Supabase stack.
# Run `npx supabase status` to obtain the URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy local CLI name; use the publishable key above when available.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://authenticator:postgres@127.0.0.1:54322/postgres
# Server-only Supabase service-role key. Never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Required only by the protected local calendar tick route/CLI.
CALENDAR_TICK_SECRET=change-me-local-calendar-secret
# Runtime boundary: production builds fail closed unless this is explicitly pilot.
FLASH_RUNTIME_SCOPE=development
# Competitive request burst (default: 30; refills one request every 2 seconds).
FLASH_RATE_LIMIT_BURST=30
# Alphabet answer/pass burst per player and attempt (default: 5; refills one action per second).
FLASH_ALPHABET_ACTION_RATE_LIMIT_BURST=5
# Optional burst override for superadmin operations (default: 10).
FLASH_ADMIN_RATE_LIMIT_BURST=10
# Canonical origin required by cookie-authenticated competitive mutations in pilot.
APP_ORIGIN=http://127.0.0.1:3000
# Private diagnostic endpoint; never expose this value to the browser.
HEALTHCHECK_SECRET=change-me-local-health-secret
# Latest applied migration expected by the private health check.
EXPECTED_SCHEMA_REVISION=20260925120000_s20_superadmin_attempt_inspection
