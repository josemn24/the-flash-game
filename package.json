{
  "name": "the-flash-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dictionary:generate": "node scripts/generate-mini-wordle-dictionary.mjs --length=4 && node scripts/generate-mini-wordle-dictionary.mjs --length=5",
    "dictionary:check": "node scripts/generate-mini-wordle-dictionary.mjs --length=4 --check && node scripts/generate-mini-wordle-dictionary.mjs --length=5 --check",
    "test": "vitest run",
    "lint": "eslint",
    "stylelint": "stylelint \"**/*.{css,module.css}\"",
    "style-architecture": "node scripts/check-style-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dictionary-es": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "nspell": "^2.1.5",
    "prettier": "^3.9.5",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
